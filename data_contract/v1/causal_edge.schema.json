{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diagsafe.local/data-contract/v1/causal_edge.schema.json",
  "title": "DiagSafe-VL adjudicated causal edge v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edge_id", "group_id", "split", "left_id", "right_id", "target_stage", "intervention", "relation", "causal_status"],
  "properties": {
    "schema_version": {"const": "diagsafe_causal_edge_v1"},
    "edge_id": {"$ref": "#/$defs/nonEmptyString"},
    "group_id": {"$ref": "#/$defs/nonEmptyString"},
    "split": {"enum": ["train", "dev", "test_hidden"]},
    "left_id": {"$ref": "#/$defs/nonEmptyString"},
    "right_id": {"$ref": "#/$defs/nonEmptyString"},
    "target_stage": {"enum": ["S1", "S2", "S3", "S4", "S5"]},
    "intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "changed_fields", "changed_factor"],
      "properties": {
        "operation": {"enum": ["natural_pair", "image_replacement", "image_withheld", "ocr_transcript_change", "query_paraphrase", "query_semantic_edit", "policy_rule_replaced", "target_rule_removed", "policy_deck_empty", "policy_decoy_added", "policy_order_shuffle", "response_replacement", "other_documented"]},
        "changed_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["query", "images", "ocr_text", "policy_deck", "response_candidate"]}},
        "changed_factor": {"enum": ["visual_evidence", "ocr_text", "image_text_binding", "intent", "policy_rule", "response_execution", "none", "mixed", "unknown"]}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["target_F", "decision", "stable_non_target_stages"],
      "properties": {
        "target_F": {"enum": ["flip", "stable", "uncertain", "not_applicable"]},
        "decision": {"enum": ["same", "different", "uncertain"]},
        "stable_non_target_stages": {"type": "array", "uniqueItems": true, "items": {"enum": ["S1", "S2", "S3", "S4", "S5"]}}
      }
    },
    "causal_status": {"enum": ["single_factor_verified", "natural_matched", "confounded", "undetermined"]}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1}
  }
}
