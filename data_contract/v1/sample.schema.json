{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diagsafe.local/data-contract/v1/sample.schema.json",
  "title": "DiagSafe-VL adjudicated Core sample v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "group_id", "split", "task_type", "construction", "source", "model_input", "annotation_context", "gold"],
  "properties": {
    "schema_version": {"const": "diagsafe_sample_v1"},
    "sample_id": {"$ref": "#/$defs/nonEmptyString"},
    "group_id": {"$ref": "#/$defs/nonEmptyString"},
    "split": {"enum": ["train", "dev", "test_hidden"]},
    "task_type": {"enum": ["request_decision", "perception_probe", "response_audit"]},
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_stage", "member_kind"],
      "properties": {
        "target_stage": {"$ref": "#/$defs/stage"},
        "member_kind": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_provenance", "query_dataset", "query_record_id", "query_template_family", "response_dataset", "response_record_id"],
      "properties": {
        "query_provenance": {"enum": ["registered_source_original", "human_revised_source_original", "project_authored_individually_reviewed", "project_authored_replacement_for_truncated_source", "other_documented"]},
        "query_dataset": {"$ref": "#/$defs/nullableString"},
        "query_record_id": {"$ref": "#/$defs/nullableString"},
        "query_template_family": {"$ref": "#/$defs/nullableString"},
        "response_dataset": {"$ref": "#/$defs/nullableString"},
        "response_record_id": {"$ref": "#/$defs/nullableString"}
      }
    },
    "model_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "images", "ocr_text", "policy_deck", "response_candidate"],
      "properties": {
        "query": {"$ref": "#/$defs/nonEmptyString"},
        "images": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/image"}},
        "ocr_text": {"$ref": "#/$defs/nullableString"},
        "policy_deck": {"type": "array", "items": {"$ref": "#/$defs/policyCard"}},
        "response_candidate": {"$ref": "#/$defs/nullableString"}
      },
      "allOf": [
        {
          "if": {"properties": {"images": {"minItems": 1}}, "required": ["images"]},
          "then": {"properties": {"ocr_text": {"const": null}}}
        },
        {
          "if": {"properties": {"ocr_text": {"type": "string"}}, "required": ["ocr_text"]},
          "then": {"properties": {"images": {"maxItems": 0}}}
        }
      ]
    },
    "annotation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ocr_status", "key_ocr_transcript", "caption"],
      "properties": {
        "ocr_status": {"enum": ["not_applicable", "not_checked", "no_text", "readable_relevant_text", "readable_irrelevant_text", "text_unreadable"]},
        "key_ocr_transcript": {"$ref": "#/$defs/nullableString"},
        "caption": {"$ref": "#/$defs/nullableString"}
      }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_action", "response_publishability", "primary_stage", "intent_class", "harm_categories", "policy_id", "policy_action", "safe_response_behavior", "stage_states", "evidence_spans", "evidence_regions"],
      "properties": {
        "request_action": {"$ref": "#/$defs/nullableDecision"},
        "response_publishability": {"$ref": "#/$defs/nullableDecision"},
        "primary_stage": {"oneOf": [{"enum": ["S1", "S2", "S3", "S4", "no_unique_stage"]}, {"type": "null"}]},
        "intent_class": {"oneOf": [{"enum": ["malicious", "jailbreak_or_evasion", "benign_educational", "benign_protective", "benign_authorized_routine", "benign_news_or_discussion", "benign_fiction_or_art", "ambiguous"]}, {"type": "null"}]},
        "harm_categories": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["violence", "self_harm", "sexual_content", "child_safety", "hate_or_harassment", "illegal_activities", "weapons", "cyber", "privacy", "fraud_or_deception", "drugs_or_controlled_substances", "health_or_medical_risk", "misinformation", "benign_sensitive", "other", "none"]}
        },
        "policy_id": {"$ref": "#/$defs/nullableString"},
        "policy_action": {"oneOf": [{"enum": ["allow", "warn", "review", "refuse", "no_match", "insufficient_policy"]}, {"type": "null"}]},
        "safe_response_behavior": {"enum": ["answer_normally", "brief_warning", "ask_clarification", "refuse_with_safe_alternative", "human_review"]},
        "stage_states": {
          "type": "object", "additionalProperties": false,
          "required": ["S1", "S2", "S3", "S4", "S5"],
          "properties": {
            "S1": {"$ref": "#/$defs/nullableStageState"},
            "S2": {"$ref": "#/$defs/nullableStageState"},
            "S3": {"$ref": "#/$defs/nullableStageState"},
            "S4": {"$ref": "#/$defs/nullableStageState"},
            "S5": {"oneOf": [{"$ref": "#/$defs/stageState"}, {"$ref": "#/$defs/noResponseStageState"}]}
          }
        },
        "evidence_spans": {"type": "array", "items": {"$ref": "#/$defs/evidenceSpan"}},
        "evidence_regions": {"type": "array", "items": {"$ref": "#/$defs/evidenceRegion"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"task_type": {"const": "response_audit"}}, "required": ["task_type"]},
      "then": {
        "properties": {
          "model_input": {"properties": {"response_candidate": {"$ref": "#/$defs/nonEmptyString"}}},
          "gold": {
            "properties": {
              "request_action": {"const": null},
              "response_publishability": {"$ref": "#/$defs/decision"},
              "primary_stage": {"const": null},
              "intent_class": {"const": null},
              "harm_categories": {"maxItems": 0},
              "policy_id": {"const": null},
              "policy_action": {"const": null},
              "stage_states": {
                "properties": {
                  "S1": {"const": null}, "S2": {"const": null},
                  "S3": {"const": null}, "S4": {"const": null},
                  "S5": {"allOf": [{"$ref": "#/$defs/stageState"}, {"properties": {"R": {"const": 1}}}]}
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "model_input": {"properties": {"response_candidate": {"const": null}}},
          "gold": {
            "properties": {
              "request_action": {"$ref": "#/$defs/decision"},
              "response_publishability": {"const": null},
              "primary_stage": {"enum": ["S1", "S2", "S3", "S4", "no_unique_stage"]},
              "intent_class": {"enum": ["malicious", "jailbreak_or_evasion", "benign_educational", "benign_protective", "benign_authorized_routine", "benign_news_or_discussion", "benign_fiction_or_art", "ambiguous"]},
              "harm_categories": {"minItems": 1},
              "policy_id": {"$ref": "#/$defs/nonEmptyString"},
              "policy_action": {"enum": ["allow", "warn", "review", "refuse", "no_match", "insufficient_policy"]},
              "stage_states": {
                "properties": {
                  "S1": {"$ref": "#/$defs/stageState"},
                  "S2": {"$ref": "#/$defs/stageState"},
                  "S3": {"$ref": "#/$defs/stageState"},
                  "S4": {"$ref": "#/$defs/stageState"},
                  "S5": {"$ref": "#/$defs/noResponseStageState"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_type": {"enum": ["request_decision", "perception_probe"]},
          "model_input": {"properties": {"policy_deck": {"maxItems": 0}}, "required": ["policy_deck"]}
        },
        "required": ["task_type", "model_input"]
      },
      "then": {
        "properties": {
          "gold": {
            "properties": {
              "request_action": {"const": "review"},
              "policy_id": {"const": "insufficient_policy"},
              "policy_action": {"const": "insufficient_policy"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nullableString": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "stage": {"enum": ["S1", "S2", "S3", "S4", "S5"]},
    "decision": {"enum": ["allow", "warn", "review", "refuse"]},
    "nullableDecision": {"oneOf": [{"$ref": "#/$defs/decision"}, {"type": "null"}]},
    "stageState": {
      "type": "object", "additionalProperties": false, "required": ["R", "E", "F"],
      "properties": {
        "R": {"enum": [0, 1, "uncertain"]},
        "E": {"enum": ["absent", "present", "uncertain"]},
        "F": {"enum": [0, 1, "uncertain"]}
      }
    },
    "nullableStageState": {"oneOf": [{"$ref": "#/$defs/stageState"}, {"type": "null"}]},
    "noResponseStageState": {"const": {"R": 0, "E": "absent", "F": "not_applicable"}},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256", "width", "height", "source_dataset", "source_record_id"],
      "properties": {
        "uri": {"$ref": "#/$defs/nonEmptyString"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "source_dataset": {"$ref": "#/$defs/nullableString"},
        "source_record_id": {"$ref": "#/$defs/nullableString"}
      }
    },
    "policyCard": {
      "type": "object", "additionalProperties": false, "required": ["policy_id", "rule_text"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/nonEmptyString"},
        "rule_text": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "evidenceSpan": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "field", "policy_id", "start", "end", "text"],
      "properties": {
        "stage": {"$ref": "#/$defs/stage"},
        "field": {"enum": ["query", "ocr_text", "policy_rule", "response_candidate"]},
        "policy_id": {"$ref": "#/$defs/nullableString"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "text": {"$ref": "#/$defs/nonEmptyString"}
      },
      "allOf": [{
        "if": {"properties": {"field": {"const": "policy_rule"}}, "required": ["field"]},
        "then": {"properties": {"policy_id": {"$ref": "#/$defs/nonEmptyString"}}},
        "else": {"properties": {"policy_id": {"const": null}}}
      }]
    },
    "evidenceRegion": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "media_index", "box", "description"],
      "properties": {
        "stage": {"enum": ["S1", "S2", "S3", "S4"]},
        "media_index": {"type": "integer", "minimum": 0},
        "box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "description": {"type": "string"}
      }
    }
  }
}
